# Point DNS A/AAAA at your VPS and open TCP 80/443.
DOMAIN=sorter.example.com

# Choose your admin password (16–256 characters). Use single quotes.
ADMIN_PASSWORD=''

# Configure Linux host TCP BBR on install/update (1 by default; 0 skips).
# This changes host networking; requires root and never changes Docker settings.
PHOTOSORTER_ENABLE_BBR=1
