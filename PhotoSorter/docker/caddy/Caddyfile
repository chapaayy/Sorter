# Upload throughput experiment: force HTTP/1.1 so browsers can use multiple
# independent TCP connections instead of multiplexing on one h2/h3 connection.
# Revert this global block to restore Caddy defaults (h1, h2, h3).
{
  servers :443 {
    protocols h1
  }
}

{$DOMAIN} {
  encode zstd gzip
  request_body {
    max_size 64MB
  }
  reverse_proxy api:8000 {
    transport http {
      read_timeout 1h
      write_timeout 1h
    }
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    -Server
  }
}
